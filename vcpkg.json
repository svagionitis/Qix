{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "qix",
  "version-string": "1.0.0",
  "description": "Modern C++17 recreation of the 1981 arcade classic Qix",
  "homepage": "https://github.com/svagionitis/Qix",
  "builtin-baseline": "4eb0f7cabb9ca18132d80009312411b9261bba7b",
  "dependencies": [
    "sdl2",
    "raylib"
  ],
  "features": {
    "gui": {
      "description": "Desktop Qt graphical client",
      "dependencies": [
        {
          "name": "qtbase",
          "features": [
            "gui",
            "widgets"
          ]
        }
      ]
    },
    "tests": {
      "description": "GoogleTest unit test suite",
      "dependencies": [
        "gtest"
      ]
    }
  }
}